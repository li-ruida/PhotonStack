if(NOT DEFINED CLI)
  message(FATAL_ERROR "CLI executable path is required")
endif()
string(RANDOM LENGTH 12 run_id)
set(root "${CMAKE_CURRENT_BINARY_DIR}/preflight-contract-${run_id}")
file(MAKE_DIRECTORY "${root}/existing")
file(WRITE "${root}/existing/retained.txt" "do not change")
file(WRITE "${root}/recipe.txt" "PHOTONSTACK_DEEP_SKY_RECIPE 1\n")
file(SHA256 "${root}/existing/retained.txt" before)
foreach(destination "${root}/existing" "${root}/uncreated/run")
  execute_process(COMMAND "${CLI}" deep-sky --recipe "${root}/recipe.txt" --output-dir "${destination}" --preflight
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Preflight failed to report: ${output} ${error}")
  endif()
  string(JSON command GET "${output}" command)
  string(JSON issue GET "${output}" issues 0 code)
  if(NOT command STREQUAL "deep-sky preflight" OR NOT issue STREQUAL "InputMissing")
    message(FATAL_ERROR "Missing inputs must be explicit in a planning report: ${output}")
  endif()
endforeach()
foreach(conflict --analyze-only --preflight)
  execute_process(COMMAND "${CLI}" deep-sky --recipe "${root}/recipe.txt" --output-dir "${root}/uncreated/run" --preflight "${conflict}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(status EQUAL 0)
    message(FATAL_ERROR "Conflicting or repeated planning flag accepted: ${output}")
  endif()
endforeach()
file(SHA256 "${root}/existing/retained.txt" after)
if(NOT before STREQUAL after OR EXISTS "${root}/uncreated" OR EXISTS "${root}/existing/report.json")
  message(FATAL_ERROR "Preflight changed destination contents")
endif()
file(REMOVE_RECURSE "${root}")
