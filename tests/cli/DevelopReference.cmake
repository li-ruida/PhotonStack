if(NOT DEFINED CLI)
  message(FATAL_ERROR "CLI executable path is required")
endif()
string(RANDOM LENGTH 12 run_id)
set(root "${CMAKE_CURRENT_BINARY_DIR}/develop-reference-${run_id}")
file(MAKE_DIRECTORY "${root}")
function(reject expected)
  execute_process(COMMAND "${CLI}" develop ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${error}")
  endif()
endfunction()
reject(ArgumentMissing --statistics-reference)
file(WRITE "${root}/reference.fits" "protected reference bytes")
file(SHA256 "${root}/reference.fits" before)
file(CREATE_LINK "${root}/reference.fits" "${root}/hard.fits")
file(CREATE_LINK "${root}/absent.tiff" "${root}/dangling.tiff" SYMBOLIC)
foreach(output reference.fits hard.fits dangling.tiff)
  reject(ArgumentInvalid --input "${root}/missing.fits" --statistics-reference "${root}/reference.fits" --output "${root}/${output}")
endforeach()
file(SHA256 "${root}/reference.fits" after)
if(NOT before STREQUAL after OR EXISTS "${root}/absent.tiff")
  message(FATAL_ERROR "Reference development overwrite guard modified a file")
endif()
file(REMOVE_RECURSE "${root}")
